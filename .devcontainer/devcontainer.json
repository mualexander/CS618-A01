{
  "name": "cs618-a01",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "npm install && npm install --prefix backend",
  "postStartCommand": "docker start mongo || docker run --name mongo -d -p 27017:27017 -v mongo-data:/data/db mongo:7",
  "forwardPorts": [5173, 3000],
  "portsAttributes": {
    "5173": { "label": "vite" },
    "3000": { "label": "api" }
  }
}
